     }
 }
 
-int usb_gamepad_report(int pad, uint8_t *out, int max)
+static int usb_gamepad_report_raw(int pad, uint8_t *out, int max)
 {
     XBOX_INPUT_STATE state;
     const XBOX_GAMEPAD *g;
@@ -630,3 +630,51 @@ int usb_gamepad_report(int pad, uint8_t *out, int max)
     pad_script_apply(pad, out);
     return 20;
 }
+
+/* RECOMP_PAD_DEBUG=1: log each pad's report as the game reads it, when it
+ * changes (at most ~10 lines a second per pad so a moving stick does not
+ * flood the log), plus the first report. Layout:
+ *   id len | buttons(dpad,start,back,L3,R3) reserved | A B X Y Black White LT RT |
+ *   LX LY RX RY (16-bit LE) */
+int usb_gamepad_report(int pad, uint8_t *out, int max)
+{
+    static int dbg = -1;
+    static uint8_t last[USB_GAMEPAD_MAX][20];
+    static unsigned char seen[USB_GAMEPAD_MAX];
+    static unsigned long last_t[USB_GAMEPAD_MAX];
+    static unsigned long nrep[USB_GAMEPAD_MAX];
+    int n = usb_gamepad_report_raw(pad, out, max);
+
+    if (dbg < 0) {
+        const char *e = getenv("RECOMP_PAD_DEBUG");
+        dbg = e && *e && *e != '0';
+    }
+    if (dbg && n == 20 && (unsigned)pad < USB_GAMEPAD_MAX) {
+        unsigned long now = (unsigned long)GetTickCount();
+        nrep[pad]++;
+        if (!seen[pad] || (memcmp(last[pad], out, 20) != 0 && now - last_t[pad] >= 100)) {
+            int i;
+            fprintf(stderr, "  [PAD%d] #%lu report=", pad + 1, nrep[pad]);
+            for (i = 0; i < 20; i++)
+                fprintf(stderr, "%02X%s", out[i], i == 3 || i == 11 ? " | " : " ");
+            fprintf(stderr, " btn=%02X A%u B%u X%u Y%u blk%u wht%u LT%u RT%u "
+                    "L(%d,%d) R(%d,%d)\n", out[2], out[4], out[5], out[6], out[7],
+                    out[8], out[9], out[10], out[11],
+                    (int16_t)(out[12] | out[13] << 8), (int16_t)(out[14] | out[15] << 8),
+                    (int16_t)(out[16] | out[17] << 8), (int16_t)(out[18] | out[19] << 8));
+            fflush(stderr);
+            memcpy(last[pad], out, 20);
+            seen[pad] = 1;
+            last_t[pad] = now;
+        }
+    }
+    return n;
+}
+
+/* The device was unplugged: forget the address and configuration the host
+ * gave it, so the next one to arrive enumerates from scratch. */
+void usb_gamepad_unplug(int pad)
+{
+    s_address[pad & 3] = 0;
+    s_configuration[pad & 3] = 0;
+}
