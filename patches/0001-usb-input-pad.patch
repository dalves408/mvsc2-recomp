+/* ---- Controller layer (Xbox One / Series / 360 pads through XInput) ------
+ *
+ * Host XInput user n drives Xbox controller port n+1 (pad 0 = player 1, ...
+ * pad 3 = player 4), see usb_gamepad.c / ohci.c for the USB side.
+ *
+ * Face buttons are analog on the original Xbox (A B X Y, 0..255 pressure);
+ * XInput has them digital, so they read 0 or 255. LB/RB become Black/White
+ * and the analog triggers stay triggers. Defaults can be reshuffled with
+ *   RECOMP_PAD_MAP="lb=white,rb=black,lt=x"   (sources a b x y lb rb lt rt,
+ *                                              destinations a b x y black
+ *                                              white lt rt, or none)
+ * Other knobs:
+ *   RECOMP_PAD_DEADZONE=N        radial stick deadzone in raw units (0..32767);
+ *                                default 7849 left / 8689 right (XInput's
+ *                                own), 0 turns it off
+ *   RECOMP_PAD_TRIGGER_DZ=N      trigger values below N read 0 (default 30)
+ *   RECOMP_PAD_STICK_DPAD=0      do not mirror the left stick onto the D-pad
+ *                                (default on: fighting games and menus are
+ *                                happy with either)
+ *   RECOMP_PAD_DEBUG=1           log pad connect/disconnect and the report
+ *                                bytes sent to the game (usb_gamepad.c)
+ *   RECOMP_PAD_FAKE="n:from-to,..."  pretend pad n is connected (idle) between
+ *                                two times in ms (test aid, no hardware)
+ *   RECOMP_PAD_SELFTEST=1        run the mapper on synthetic XInput states and
+ *                                log PASS/FAIL (xbox_InputSelfTest)
+ */
 static BOOL  g_controller_connected[XBOX_MAX_CONTROLLERS] = { FALSE };
 static DWORD g_last_packet[XBOX_MAX_CONTROLLERS] = { 0 };
 
+static int    s_cfg_done;
+static int    s_dz_left = 7849, s_dz_right = 8689, s_trig_dz = 30;
+static int    s_stick_dpad = 1;
+static int    s_debug;
+static signed char s_map[8] = { 0, 1, 2, 3, 4, 5, 6, 7 };  /* a b x y lb rb lt rt -> dest */
+
+typedef struct { int port; DWORD from, to; } FakeWin;
+static FakeWin s_fake[8];
+static int     s_nfake;
+
+/* Injected states for the self-test. */
+static XINPUT_STATE s_inject[XBOX_MAX_CONTROLLERS];
+static int          s_inject_on[XBOX_MAX_CONTROLLERS];
+
+static int dest_by_name(const char *p, size_t n)
+{
+    static const char *names[] = { "a", "b", "x", "y", "black", "white", "lt", "rt" };
+    int i;
+    for (i = 0; i < 8; i++)
+        if (strlen(names[i]) == n && _strnicmp(p, names[i], n) == 0)
+            return i;
+    if (n == 4 && _strnicmp(p, "none", 4) == 0)
+        return -1;
+    return -2;
+}
+
+static int src_by_name(const char *p, size_t n)
+{
+    static const char *names[] = { "a", "b", "x", "y", "lb", "rb", "lt", "rt" };
+    int i;
+    for (i = 0; i < 8; i++)
+        if (strlen(names[i]) == n && _strnicmp(p, names[i], n) == 0)
+            return i;
+    return -1;
+}
+
+static void cfg_load(void)
+{
+    const char *e;
+    if (s_cfg_done)
+        return;
+    s_cfg_done = 1;
+    if ((e = getenv("RECOMP_PAD_DEADZONE")) && *e) {
+        s_dz_left = s_dz_right = atoi(e);
+        if (s_dz_left < 0) s_dz_left = s_dz_right = 0;
+        if (s_dz_left > 30000) s_dz_left = s_dz_right = 30000;
+    }
+    if ((e = getenv("RECOMP_PAD_TRIGGER_DZ")) && *e)
+        s_trig_dz = atoi(e);
+    if ((e = getenv("RECOMP_PAD_STICK_DPAD")) && *e)
+        s_stick_dpad = atoi(e) != 0;
+    s_debug = (e = getenv("RECOMP_PAD_DEBUG")) && *e && *e != '0';
+    if ((e = getenv("RECOMP_PAD_MAP")) && *e) {
+        while (*e) {
+            const char *eq, *end;
+            int s, d;
+            while (*e == ' ' || *e == ',') e++;
+            if (!*e) break;
+            eq = strchr(e, '=');
+            end = e;
+            while (*end && *end != ',') end++;
+            if (eq && eq < end) {
+                s = src_by_name(e, (size_t)(eq - e));
+                d = dest_by_name(eq + 1, (size_t)(end - eq - 1));
+                if (s >= 0 && d >= -1)
+                    s_map[s] = (signed char)d;
+                else
+                    fprintf(stderr, "  [PAD] bad RECOMP_PAD_MAP entry ignored\n");
+            }
+            e = end;
+        }
+    }
+    if ((e = getenv("RECOMP_PAD_FAKE")) && *e) {
+        while (*e && s_nfake < 8) {
+            int port = atoi(e);
+            const char *c = strchr(e, ':');
+            const char *dash = c ? strchr(c, '-') : NULL;
+            const char *end = strchr(e, ',');
+            FakeWin *f = &s_fake[s_nfake];
+            if (!c) break;
+            f->port = port;
+            f->from = (DWORD)atol(c + 1);
+            f->to = (dash && (!end || dash < end) && dash[1] >= '0' && dash[1] <= '9')
+                        ? (DWORD)atol(dash + 1) : 0xFFFFFFFFu;
+            if (port >= 0 && port < XBOX_MAX_CONTROLLERS)
+                s_nfake++;
+            if (!end) break;
+            e = end + 1;
+        }
+    }
+    if (s_debug)
+        fprintf(stderr, "  [PAD] config: deadzone L=%d R=%d trigger=%d stick->dpad=%d "
+                "map(a b x y lb rb lt rt)=%d %d %d %d %d %d %d %d fake=%d\n",
+                s_dz_left, s_dz_right, s_trig_dz, s_stick_dpad,
+                s_map[0], s_map[1], s_map[2], s_map[3], s_map[4], s_map[5],
+                s_map[6], s_map[7], s_nfake);
+}
+
+/* Radial deadzone with rescale, so the stick still reaches full range. */
+static void stick_deadzone(SHORT *px, SHORT *py, int dz)
+{
+    double x = *px, y = *py, m = sqrt(x * x + y * y), k, nx, ny;
+    if (dz <= 0 || m == 0.0)
+        return;
+    if (m <= dz) {
+        *px = *py = 0;
+        return;
+    }
+    k = (m - dz) / (32767.0 - dz);
+    if (k > 1.0) k = 1.0;
+    nx = x / m * k * 32767.0;
+    ny = y / m * k * 32767.0;
+    if (nx > 32767.0) nx = 32767.0;
+    if (nx < -32767.0) nx = -32767.0;
+    if (ny > 32767.0) ny = 32767.0;
+    if (ny < -32767.0) ny = -32767.0;
+    *px = (SHORT)nx;
+    *py = (SHORT)ny;
+}
+
+/* One XInput state -> one Xbox pad state (no keyboard). */
+static void map_xinput(const XINPUT_STATE *xi, XBOX_INPUT_STATE *out)
+{
+    const XINPUT_GAMEPAD *g = &xi->Gamepad;
+    unsigned src[8];
+    int i;
+
+    memset(out, 0, sizeof *out);
+    out->dwPacketNumber = xi->dwPacketNumber;
+    out->Gamepad.wButtons = g->wButtons & 0x00FF;   /* dpad, start, back, thumbs: same bits */
+
+    src[0] = (g->wButtons & XINPUT_GAMEPAD_A) ? 255 : 0;
+    src[1] = (g->wButtons & XINPUT_GAMEPAD_B) ? 255 : 0;
+    src[2] = (g->wButtons & XINPUT_GAMEPAD_X) ? 255 : 0;
+    src[3] = (g->wButtons & XINPUT_GAMEPAD_Y) ? 255 : 0;
+    src[4] = (g->wButtons & XINPUT_GAMEPAD_LEFT_SHOULDER) ? 255 : 0;
+    src[5] = (g->wButtons & XINPUT_GAMEPAD_RIGHT_SHOULDER) ? 255 : 0;
+    src[6] = g->bLeftTrigger  >= s_trig_dz ? g->bLeftTrigger  : 0;
+    src[7] = g->bRightTrigger >= s_trig_dz ? g->bRightTrigger : 0;
+    for (i = 0; i < 8; i++) {
+        int d = s_map[i];
+        if (d >= 0 && src[i] > out->Gamepad.bAnalogButtons[d])
+            out->Gamepad.bAnalogButtons[d] = (BYTE)src[i];
+    }
+
+    out->Gamepad.sThumbLX = g->sThumbLX;
+    out->Gamepad.sThumbLY = g->sThumbLY;
+    out->Gamepad.sThumbRX = g->sThumbRX;
+    out->Gamepad.sThumbRY = g->sThumbRY;
+    stick_deadzone(&out->Gamepad.sThumbLX, &out->Gamepad.sThumbLY, s_dz_left);
+    stick_deadzone(&out->Gamepad.sThumbRX, &out->Gamepad.sThumbRY, s_dz_right);
+
+    if (s_stick_dpad) {
+        if (out->Gamepad.sThumbLY >  16384) out->Gamepad.wButtons |= XBOX_GAMEPAD_DPAD_UP;
+        if (out->Gamepad.sThumbLY < -16384) out->Gamepad.wButtons |= XBOX_GAMEPAD_DPAD_DOWN;
+        if (out->Gamepad.sThumbLX < -16384) out->Gamepad.wButtons |= XBOX_GAMEPAD_DPAD_LEFT;
+        if (out->Gamepad.sThumbLX >  16384) out->Gamepad.wButtons |= XBOX_GAMEPAD_DPAD_RIGHT;
+    }
+}
+
+/* Is a fake (test) pad window open for this port? */
+static int fake_active(DWORD port)
+{
+    static DWORD t0;
+    DWORD now = GetTickCount(), t;
+    int i;
+    if (!s_nfake)
+        return 0;
+    if (!t0)
+        t0 = now ? now : 1;
+    t = now - t0;
+    for (i = 0; i < s_nfake; i++)
+        if ((DWORD)s_fake[i].port == port && t >= s_fake[i].from && t < s_fake[i].to)
+            return 1;
+    return 0;
+}
+
+/* XInputGetState on an empty slot is slow on some systems, and a hot-plugged
+ * pad does not need millisecond latency to be noticed: an absent slot is
+ * probed once a second, a present one on every call. */
+static DWORD pad_query(DWORD port, XINPUT_STATE *st)
+{
+    static DWORD last_probe[XBOX_MAX_CONTROLLERS];
+    static unsigned char probed[XBOX_MAX_CONTROLLERS];
+    DWORD now = GetTickCount(), rc;
+
+    cfg_load();
+    if (s_inject_on[port]) {
+        *st = s_inject[port];
+        return ERROR_SUCCESS;
+    }
+    if (fake_active(port)) {
+        memset(st, 0, sizeof *st);
+        st->dwPacketNumber = ++g_last_packet[port];
+        if (!g_controller_connected[port]) {
+            g_controller_connected[port] = TRUE;
+            fprintf(stderr, "  [PAD] host pad %lu connected (simulated)\n", (unsigned long)port);
+        }
+        return ERROR_SUCCESS;
+    }
+    if (!g_controller_connected[port] && probed[port] && now - last_probe[port] < 1000)
+        return ERROR_DEVICE_NOT_CONNECTED;
+    rc = XInputGetState(port, st);
+    if (rc == ERROR_SUCCESS) {
+        if (!g_controller_connected[port]) {
+            XINPUT_CAPABILITIES caps;
+            g_controller_connected[port] = TRUE;
+            if (XInputGetCapabilities(port, 0, &caps) == ERROR_SUCCESS)
+                fprintf(stderr, "  [PAD] host pad %lu connected: XInput type %u subtype %u "
+                        "(-> Xbox controller port %lu)\n", (unsigned long)port,
+                        caps.Type, caps.SubType, (unsigned long)port + 1);
+            else
+                fprintf(stderr, "  [PAD] host pad %lu connected (-> Xbox controller port %lu)\n",
+                        (unsigned long)port, (unsigned long)port + 1);
+        }
+    } else {
+        if (g_controller_connected[port])
+            fprintf(stderr, "  [PAD] host pad %lu disconnected\n", (unsigned long)port);
+        g_controller_connected[port] = FALSE;
+        last_probe[port] = now;
+        probed[port] = 1;
+    }
+    return rc;
+}
+
+BOOL xbox_InputPadPresent(DWORD dwPort)
+{
+    XINPUT_STATE st;
+    if (dwPort >= XBOX_MAX_CONTROLLERS)
+        return FALSE;
+    return pad_query(dwPort, &st) == ERROR_SUCCESS;
+}
