+/* ---- Self-test: synthetic XInput states through the real path ------------
+ * Drives usb_gamepad_report(), so what is checked is the 20-byte report the
+ * game's USB stack would read, not just the mapper. */
+extern int usb_gamepad_report(int pad, uint8_t *out, int max);
+
+static int st_check(const char *name, int pad, const uint8_t *want, const uint8_t *got)
+{
+    int i, ok = memcmp(want, got, 20) == 0;
+    fprintf(stderr, "  [PADTEST] %-28s pad %d %s  report=", name, pad, ok ? "PASS" : "FAIL");
+    for (i = 0; i < 20; i++)
+        fprintf(stderr, "%02X%s", got[i], i == 3 || i == 11 ? "|" : " ");
+    if (!ok) {
+        fprintf(stderr, " expected=");
+        for (i = 0; i < 20; i++)
+            fprintf(stderr, "%02X ", want[i]);
+    }
+    fputc('\n', stderr);
+    return ok;
+}
+
+int xbox_InputSelfTest(void)
+{
+    int fails = 0, saved_dz_l, saved_dz_r, saved_sd, saved_kbd_dummy = 0, p;
+    uint8_t got[20], want[20];
+    XINPUT_STATE x;
+    signed char saved_map[8];
+
+    (void)saved_kbd_dummy;
+    cfg_load();
+    saved_dz_l = s_dz_left; saved_dz_r = s_dz_right; saved_sd = s_stick_dpad;
+    memcpy(saved_map, s_map, sizeof saved_map);
+    { static const signed char dflt[8] = { 0, 1, 2, 3, 4, 5, 6, 7 }; memcpy(s_map, dflt, 8); }
+    s_dz_left = s_dz_right = 0; s_stick_dpad = 0;
+    fprintf(stderr, "  [PADTEST] begin (default layout, deadzone off, stick->dpad off)\n");
+
+    /* 1: face buttons -> analog A B X Y, shoulders -> Black/White */
+    memset(&x, 0, sizeof x); x.dwPacketNumber = 1;
+    x.Gamepad.wButtons = XINPUT_GAMEPAD_A | XINPUT_GAMEPAD_Y |
+                         XINPUT_GAMEPAD_LEFT_SHOULDER;
+    memset(want, 0, 20); want[1] = 20;
+    want[4] = 255; want[7] = 255; want[8] = 255;     /* A, Y, Black */
+    s_inject[0] = x; s_inject_on[0] = 1;
+    usb_gamepad_report(0, got, 20);
+    fails += !st_check("A+Y+LB -> A,Y,Black", 0, want, got);
+
+    /* 2: digital group: dpad, start, back, thumb clicks; RB -> White; B, X */
+    x.Gamepad.wButtons = XINPUT_GAMEPAD_DPAD_UP | XINPUT_GAMEPAD_DPAD_RIGHT |
+                         XINPUT_GAMEPAD_START | XINPUT_GAMEPAD_BACK |
+                         XINPUT_GAMEPAD_LEFT_THUMB | XINPUT_GAMEPAD_RIGHT_THUMB |
+                         XINPUT_GAMEPAD_RIGHT_SHOULDER | XINPUT_GAMEPAD_B |
+                         XINPUT_GAMEPAD_X;
+    memset(want, 0, 20); want[1] = 20;
+    want[2] = 0x01 | 0x08 | 0x10 | 0x20 | 0x40 | 0x80;
+    want[5] = 255; want[6] = 255; want[9] = 255;     /* B, X, White */
+    s_inject[0] = x;
+    usb_gamepad_report(0, got, 20);
+    fails += !st_check("dpad/start/back/clicks/B/X/RB", 0, want, got);
+
+    /* 3: triggers and sticks, exact pass-through with deadzone off */
+    memset(&x, 0, sizeof x); x.dwPacketNumber = 3;
+    x.Gamepad.bLeftTrigger = 200; x.Gamepad.bRightTrigger = 77;
+    x.Gamepad.sThumbLX = 20000; x.Gamepad.sThumbLY = -10000;
+    x.Gamepad.sThumbRX = -32768 + 1; x.Gamepad.sThumbRY = 1234;
+    memset(want, 0, 20); want[1] = 20;
+    want[10] = 200; want[11] = 77;
+    want[12] = 20000 & 255; want[13] = 20000 >> 8;
+    want[14] = (uint8_t)(-10000 & 255); want[15] = (uint8_t)((-10000 >> 8) & 255);
+    want[16] = (uint8_t)((-32767) & 255); want[17] = (uint8_t)(((-32767) >> 8) & 255);
+    want[18] = 1234 & 255; want[19] = 1234 >> 8;
+    s_inject[0] = x;
+    usb_gamepad_report(0, got, 20);
+    fails += !st_check("triggers + sticks exact", 0, want, got);
+
+    /* 4: deadzone on: small deflection -> 0, full stays full; stick->dpad */
+    s_dz_left = 7849; s_dz_right = 8689; s_stick_dpad = 1;
+    memset(&x, 0, sizeof x); x.dwPacketNumber = 4;
+    x.Gamepad.sThumbLX = 5000; x.Gamepad.sThumbLY = 5000;     /* inside */
+    x.Gamepad.sThumbRX = 32767;                               /* full */
+    x.Gamepad.bLeftTrigger = 20;                              /* under 30 */
+    memset(want, 0, 20); want[1] = 20;
+    want[16] = 0xFF; want[17] = 0x7F;
+    s_inject[0] = x;
+    usb_gamepad_report(0, got, 20);
+    fails += !st_check("deadzone small->0, full->full", 0, want, got);
+
+    memset(&x, 0, sizeof x); x.dwPacketNumber = 5;
+    x.Gamepad.sThumbLX = -32767;                              /* full left */
+    memset(want, 0, 20); want[1] = 20;
+    want[2] = 0x04;                                           /* stick -> dpad left */
+    want[12] = 0x01; want[13] = 0x80;                         /* -32767 */
+    s_inject[0] = x;
+    usb_gamepad_report(0, got, 20);
+    fails += !st_check("stick left -> dpad + axis", 0, want, got);
+
+    /* 5: remap lb<->rb and 4 players: each pad reports only its own state */
+    s_dz_left = s_dz_right = 0; s_stick_dpad = 0;
+    s_inject_on[0] = 0;
+    for (p = 0; p < 4; p++) {
+        memset(&x, 0, sizeof x); x.dwPacketNumber = 10 + p;
+        x.Gamepad.wButtons = (WORD)(p == 0 ? XINPUT_GAMEPAD_A : p == 1 ? XINPUT_GAMEPAD_B :
+                                    p == 2 ? XINPUT_GAMEPAD_X : XINPUT_GAMEPAD_Y);
+        s_inject[p] = x; s_inject_on[p] = 1;
+    }
+    for (p = 0; p < 4; p++) {
+        memset(want, 0, 20); want[1] = 20; want[4 + p] = 255;
+        usb_gamepad_report(p, got, 20);
+        fails += !st_check("4 pads, own buttons only", p, want, got);
+    }
+    s_map[4] = 5; s_map[5] = 4;                               /* swap LB/RB */
+    memset(&x, 0, sizeof x); x.dwPacketNumber = 20;
+    x.Gamepad.wButtons = XINPUT_GAMEPAD_LEFT_SHOULDER;
+    s_inject[1] = x;
+    memset(want, 0, 20); want[1] = 20; want[9] = 255;         /* LB -> White */
+    usb_gamepad_report(1, got, 20);
+    fails += !st_check("remap LB=white", 1, want, got);
+
+    for (p = 0; p < 4; p++) s_inject_on[p] = 0;
