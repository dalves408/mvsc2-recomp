diff --git a/src/kernel/kernel_thread.c b/src/kernel/kernel_thread.c
index 9afbbe3..4921074 100644
--- a/src/kernel/kernel_thread.c
+++ b/src/kernel/kernel_thread.c
@@ -350,6 +350,102 @@ NTSTATUS __stdcall xbox_NtDuplicateObject(
     return STATUS_SUCCESS;
 }
 
+
+/*
+ * Lost-wakeup guard (default ON; RECOMP_RESUME_TOKEN=0 disables).
+ * The title's streaming worker (sub_002000A0) parks itself with NtSuspendThread(self)
+ * after each pass; the main thread starts a pass with NtResumeThread (and, if the
+ * worker's flag is not cleared at once, resumes again a few times). On the console the
+ * worker is a higher-priority thread on a single CPU, so by the time the resume returns
+ * the pass has run and the worker is suspended again. On the host the two run in parallel:
+ * a resume that lands while the worker is still finishing its previous pass (suspend count 0)
+ * is lost, and the worker then suspends itself with work pending and never wakes.
+ * Guard: (1) a resume that finds its target not suspended leaves one token, which the
+ * target's next self-suspend consumes (returns at once, the worker just re-checks its queue);
+ * (2) a resume that finds its target committed to suspending (between the token check and
+ * the real SuspendThread) retries until the suspend has taken effect, then resumes it.
+ */
+#define RT_MAX 128
+static struct { DWORD tid; LONG tok; LONG suspending; } s_rt[RT_MAX];
+static SRWLOCK s_rt_lock = SRWLOCK_INIT;
+static int s_rt_on = -1;
+static volatile LONG s_rt_set_n, s_rt_hit_n, s_rt_race_n;
+static int rt_enabled(void)
+{
+    if (s_rt_on < 0) { const char *e = getenv("RECOMP_RESUME_TOKEN"); s_rt_on = (e && e[0] == '0') ? 0 : 1; }
+    return s_rt_on;
+}
+/* caller holds the lock */
+static int rt_find(DWORD tid, int create)
+{
+    int i, free_i = -1;
+    for (i = 0; i < RT_MAX; i++) {
+        if (s_rt[i].tid == tid) return i;
+        if (free_i < 0 && s_rt[i].tid == 0) free_i = i;
+    }
+    if (create && free_i >= 0) { s_rt[free_i].tid = tid; s_rt[free_i].tok = 0; s_rt[free_i].suspending = 0; return free_i; }
+    return -1;
+}
+/* Self-suspend: returns 1 if a pending resume was consumed (do not suspend). */
+static int rt_self_suspend_begin(DWORD tid)
+{
+    int i, consumed = 0;
+    AcquireSRWLockExclusive(&s_rt_lock);
+    i = rt_find(tid, 1);
+    if (i >= 0) {
+        if (s_rt[i].tok) { s_rt[i].tok = 0; consumed = 1; }
+        else s_rt[i].suspending = 1;
+    }
+    ReleaseSRWLockExclusive(&s_rt_lock);
+    return consumed;
+}
+static void rt_self_suspend_end(DWORD tid)
+{
+    int i;
+    AcquireSRWLockExclusive(&s_rt_lock);
+    i = rt_find(tid, 0);
+    if (i >= 0) s_rt[i].suspending = 0;
+    ReleaseSRWLockExclusive(&s_rt_lock);
+}
+static DWORD rt_resume(HANDLE h)
+{
+    DWORD prev, tid = GetThreadId(h);
+    int i, n;
+    if (!tid) return ResumeThread(h);
+    AcquireSRWLockExclusive(&s_rt_lock);
+    i = rt_find(tid, 0);
+    if (i >= 0 && s_rt[i].suspending) {
+        /* target is committed to suspend itself: wait until the suspend has taken effect */
+        for (n = 0; n < 4000; n++) {
+            prev = ResumeThread(h);
+            if (prev != 0) {
+                if (n) InterlockedIncrement(&s_rt_race_n);
+                s_rt[i].suspending = 0;
+                ReleaseSRWLockExclusive(&s_rt_lock);
+                return prev;
+            }
+            if (n < 200) SwitchToThread(); else Sleep(0);
+        }
+        s_rt[i].tok = 1;            /* gave up: leave a token instead */
+        InterlockedIncrement(&s_rt_set_n);
+        ReleaseSRWLockExclusive(&s_rt_lock);
+        return 0;
+    }
+    prev = ResumeThread(h);
+    if (prev == 0) {
+        i = rt_find(tid, 1);
+        if (i >= 0) { s_rt[i].tok = 1; InterlockedIncrement(&s_rt_set_n); }
+    }
+    ReleaseSRWLockExclusive(&s_rt_lock);
+    return prev;
+}
+/* diagnostics for the stall dump in main.c */
+void xbox_rt_dump(void)
+{
+    int i;
+    fprintf(stderr, "[RTDUMP] enabled=%d set=%ld hit=%ld race=%ld\n", rt_enabled(), (long)s_rt_set_n, (long)s_rt_hit_n, (long)s_rt_race_n);
+    for (i = 0; i < RT_MAX; i++) if (s_rt[i].tid) fprintf(stderr, "[RTDUMP]  tid=%lu tok=%ld suspending=%ld\n", (unsigned long)s_rt[i].tid, (long)s_rt[i].tok, (long)s_rt[i].suspending);
+}
