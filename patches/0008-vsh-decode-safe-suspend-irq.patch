+            for (k = 0; k < 4; k++) {
+                float c0 = outregs[3][k], c1 = outregs[4][k];
+                out->d0[k] = c0 > 1.0f ? 1.0f : (c0 >= 0.0f ? c0 : 0.0f);
+                out->d1[k] = c1 > 1.0f ? 1.0f : (c1 >= 0.0f ? c1 : 0.0f);
+            }
+            memcpy(out->fog, outregs[5], sizeof out->fog);
+            memcpy(out->tex[0], outregs[9], sizeof out->tex[0]);
+            memcpy(out->tex[1], outregs[10], sizeof out->tex[1]);
+            memcpy(out->tex[2], outregs[11], sizeof out->tex[2]);
+            memcpy(out->tex[3], outregs[12], sizeof out->tex[3]);
+            return 1;
+        }
+    }
+    return 0;
+}
+
+static int vsh_run_ref(const float in[NV2A_VSH_INPUTS][4], Nv2aVshOutput *out);
+
 int nv2a_vsh_run(const float in[NV2A_VSH_INPUTS][4], Nv2aVshOutput *out)
+{
+    static int mode = -1;                         /* 0 decoded, 1 reference, 2 verify */
+    if (mode < 0)
+        mode = getenv("RECOMP_VSH_NODECODE") ? 1 : getenv("RECOMP_VSH_VERIFY") ? 2 : 0;
+    if (mode == 0 && !s_cxt_write && !vsh_dump_enabled())
+        return vsh_run_dec(in, out);
+    if (mode == 2 && !s_cxt_write) {
+        static unsigned long long n, bad;
+        Nv2aVshOutput r;
+        int a = vsh_run_dec(in, out), b = vsh_run_ref(in, &r);
+        n++;
+        if (a != b || (a && memcmp(out, &r, sizeof r) != 0)) {
+            bad++;
+            if (bad <= 8)
+                fprintf(stderr, "  [VSH] verify MISMATCH #%llu: dec ret %d pos %g %g %g %g | ref ret %d pos %g %g %g %g\n",
+                        bad, a, out->pos[0], out->pos[1], out->pos[2], out->pos[3], b, r.pos[0], r.pos[1], r.pos[2], r.pos[3]);
+        }
+        if ((n & 0xFFFFF) == 0)
+            fprintf(stderr, "  [VSH] verify: %llu vertices, %llu mismatches\n", n, bad);
+        *out = r;
+        return b;
+    }
+    return vsh_run_ref(in, out);
+}
