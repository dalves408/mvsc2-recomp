+/* RECOMP_APU_FE_LOCK (default on, =0 off): the voice processor stopped taking d->lock per frame (see voice_spin_lock), but
+ * nothing replaced what that lock did for the title's writes. voice_set_mask is a read-modify-write of a voice word in
+ * guest memory, and voice_process rewrites the same words (PAR_STATE envelope state, PAR_OFFSET CBO) every frame: a write
+ * from the title landing inside a voice's frame was overwritten by the processor's stale copy. MvC2's music voice stopped
+ * for good that way (play position frozen, the game stops streaming, silence; 3 of 3 runs within ~6.5 min).
+ * Two halves: a single write takes the voice's spin lock, and (in the frame loop) a voice the title holds with
+ * VOICE_LOCK is skipped for that frame, as xemu stalls it, so a VOICE_LOCK..unlock bracket of writes lands whole. */
+static unsigned s_fe_lock_skips;   /* voice-frames skipped because the title held VOICE_LOCK */
+
+static int apu_fe_lock_on(void)
+{
+    static int on = -1;
+    if (on < 0) { const char *e = getenv("RECOMP_APU_FE_LOCK"); on = !(e && e[0] == '0'); }
+    return on;
+}
+
+/* The voice a guest method writes, or -1. VOICE_LOCK/ON/RELEASE are left out: they take the spin lock themselves. */
+static int fe_voice_target(MCPXAPUState *d, uint32_t method, uint32_t argument)
+{
+    switch (method) {
+    case NV1BA0_PIO_VOICE_OFF:   return (int)(argument & NV1BA0_PIO_VOICE_OFF_HANDLE);
+    case NV1BA0_PIO_VOICE_PAUSE: return (int)(argument & NV1BA0_PIO_VOICE_PAUSE_HANDLE);
+    case NV1BA0_PIO_SET_VOICE_CFG_VBIN: case NV1BA0_PIO_SET_VOICE_CFG_FMT:
+    case NV1BA0_PIO_SET_VOICE_CFG_ENV0: case NV1BA0_PIO_SET_VOICE_CFG_ENVA:
+    case NV1BA0_PIO_SET_VOICE_CFG_ENV1: case NV1BA0_PIO_SET_VOICE_CFG_ENVF:
+    case NV1BA0_PIO_SET_VOICE_CFG_MISC: case NV1BA0_PIO_SET_VOICE_TAR_HRTF:
+    case NV1BA0_PIO_SET_VOICE_TAR_VOLA: case NV1BA0_PIO_SET_VOICE_TAR_VOLB:
+    case NV1BA0_PIO_SET_VOICE_TAR_VOLC: case NV1BA0_PIO_SET_VOICE_LFO_ENV:
+    case NV1BA0_PIO_SET_VOICE_TAR_FCA:  case NV1BA0_PIO_SET_VOICE_TAR_FCB:
+    case NV1BA0_PIO_SET_VOICE_TAR_PITCH: case NV1BA0_PIO_SET_VOICE_CFG_BUF_BASE:
+    case NV1BA0_PIO_SET_VOICE_CFG_BUF_LBO: case NV1BA0_PIO_SET_VOICE_BUF_CBO:
+    case NV1BA0_PIO_SET_VOICE_CFG_BUF_EBO: case NV1BA0_PIO_SET_VOICE_SSL_A:
+    case NV1BA0_PIO_SET_VOICE_SSL_B:
+        return (int)(FE_CV(d) & 0xFFFF);
+    default:
+        return -1;
+    }
+}
