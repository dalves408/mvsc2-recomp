+                    voice_get_mask(d, (uint16_t)tv, NV_PAVS_VOICE_PAR_STATE, NV_PAVS_VOICE_PAR_STATE_ACTIVE_VOICE));
+    }
+    if (v >= 0)
+        voice_spin_lock(d, (uint16_t)v);
     /* Dispatch known methods through fe_method */
