                         unsigned int size)
 {
     MCPXAPUState *d = (MCPXAPUState *)opaque;
+    int v = apu_fe_lock_on() ? fe_voice_target(d, (uint32_t)addr, (uint32_t)val) : -1;
     (void)size;
 
+    if (v >= MCPX_HW_MAX_VOICES)
+        v = -1;
+    if (apu_statelog_on()) {
+        /* Front-end method sequences rely on shared registers: SET_CURRENT_VOICE then SET_VOICE_* (FECV), and
+         * SET_ANTECEDENT_VOICE then VOICE_ON (FEAV, the voice-list link). A write that uses FECV/FEAV set by ANOTHER host
+         * thread means two sequences interleaved (the console's single CPU and DirectSound's IRQL raise prevent that). */
+        static DWORD cv_tid, av_tid;
