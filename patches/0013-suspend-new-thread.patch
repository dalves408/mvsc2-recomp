+/* For a thread not yet running: it starts out in host code. */
+void xbox_HostCodePrepare(DWORD tid)
+{
+    SuspSlot *s = susp_find(tid, 1);
+    if (s) {
+        s->pend = s->parked = 0;
+        s->host = 1;
+    }
