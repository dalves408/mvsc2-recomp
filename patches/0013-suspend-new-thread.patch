+/* The thread's first act: take up the slot Prepare set, or a new one. */
+void xbox_HostCodeAdopt(void)
+{
+    SuspSlot *s = susp_find(GetCurrentThreadId(), 1);
+    t_susp = s;
+    if (s && InterlockedCompareExchange(&s->host, 0, 0) == 0)
+        InterlockedIncrement(&s->host);
+}
