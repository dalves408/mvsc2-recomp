diff --git a/tools/recomp/test_rmw_shared.py b/tools/recomp/test_rmw_shared.py
new file mode 100644
--- /dev/null
+++ b/tools/recomp/test_rmw_shared.py
@@ -0,0 +1,62 @@
+"""Unlocked read-modify-write instructions on shared memory lift as one atomic step.
+
+On the console's one CPU `dec dword [refcount]` cannot be split by a thread
+switch, so titles leave it unlocked. Lifted as load, store and read-back, two
+threads could both see zero and both free the object.
+"""
+import unittest
+
+from .disasm import BasicBlock, Instruction, Operand
+from .lifter import Lifter, lift_basic_block
+
+
+def _mem(base="ecx", size=4):
+    return Operand(type="mem", mem_base=base, mem_index=None, mem_scale=1, mem_disp=4, mem_size=size)
+
+
+def _lift(mnemonic, ops):
+    insn = Instruction(0, 3, mnemonic, "", "00")
+    insn.operands = ops
+    lifted, _ = lift_basic_block(Lifter(), BasicBlock(start=0, instructions=[insn]))
+    return chr(10).join(lifted)
+
+
+class RmwSharedTest(unittest.TestCase):
+    def test_dec_is_one_step_and_flags_come_from_the_old_value(self):
+        out = _lift("dec", [_mem()])
+        self.assertIn("recomp_rmw_add32(ecx + 4, 0u - 1u)", out)
+        self.assertIn("_fa = (uint32_t)(_o - 1u) & 0xFFFFFFFFu", out)
+        self.assertNotIn("MEM32", out)      # no read-back another thread could change
+
+    def test_inc_byte_uses_the_byte_form(self):
+        out = _lift("inc", [_mem(size=1)])
+        self.assertIn("recomp_rmw_add8(ecx + 4, 1u)", out)
+        self.assertIn("_fa = (uint32_t)(_o + 1u) & 0xFFu", out)
+
+    def test_alu_forms(self):
+        reg = Operand(type="reg", reg="eax")
+        self.assertIn("recomp_rmw_add32(ecx + 4, _s)", _lift("add", [_mem(), reg]))
+        self.assertIn("recomp_rmw_add32(ecx + 4, 0u - _s)", _lift("sub", [_mem(), reg]))
+        self.assertIn("recomp_rmw_and32(ecx + 4, _s)", _lift("and", [_mem(), reg]))
+        self.assertIn("recomp_rmw_or32(ecx + 4, _s)", _lift("or", [_mem(), reg]))
+        self.assertIn("recomp_rmw_xor32(ecx + 4, _s)", _lift("xor", [_mem(), reg]))
+
+    def test_not_has_no_flags(self):
+        out = _lift("not", [_mem(size=2)])
+        self.assertIn("recomp_rmw_xor16(ecx + 4, 0xFFFFFFFFu)", out)
+        self.assertNotIn("_fa", out)
+
+    def test_own_stack_stays_plain(self):
+        self.assertNotIn("recomp_rmw", _lift("dec", [_mem(base="esp")]))
+
+    def test_tib_stays_plain(self):
+        op = _mem()
+        op.mem_seg = "fs"
+        self.assertNotIn("recomp_rmw", _lift("dec", [op]))
+
+    def test_registers_stay_plain(self):
+        self.assertNotIn("recomp_rmw", _lift("dec", [Operand(type="reg", reg="eax")]))
+
+
+if __name__ == "__main__":
+    unittest.main()
