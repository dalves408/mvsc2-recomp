+def _rmw_shared(op):
+    """A memory operand other threads may touch: anything but the thread's own stack and TIB.
+
+    `dec dword [refcount]` is one instruction, so on the console's one CPU no
+    other thread can run inside it and titles use it unlocked. Lifted as a
+    separate load, store and read-back for the flags, a thread switch lands in
+    the middle: an update is lost, or two threads both see the count reach zero
+    and both free the object. So these lift through recomp_rmw_*, which are one
+    atomic step and return the old value the flags are worked out from.
+    """
+    if op.type != "mem" or getattr(op, "mem_seg", None) == "fs":
+        return False
+    return str(op.mem_base or "").lower() != "esp"
