+/* Unlocked read-modify-write instructions on shared memory (dec dword [refcount], or byte [flags], 1). One instruction is
+ * one step for other threads on the console's one CPU, so they must be one step here: see _rmw_shared in the lifter. They
+ * return the old value. Hardware registers stay a plain read and write: those addresses trap, and the trap handlers decode
+ * ordinary moves. */
+#if defined(_MSC_VER)
+#define RECOMP_RMW_DEF(name, bits, type, ltype, intr, op) \
+    static __inline uint32_t recomp_rmw_##name##bits(uint32_t va, uint32_t v) { \
+        volatile type *p = (volatile type *)((uintptr_t)va + g_xbox_mem_offset); \
+        if (va >= 0xFD000000u) { type o = *p; *p = (type)(o op (type)v); return o; } \
+        return (type)intr((volatile ltype *)p, (ltype)v); }
