diff --git a/src/video/gpu_present.c b/src/video/gpu_present.c
--- a/src/video/gpu_present.c
+++ b/src/video/gpu_present.c
@@ -46,6 +46,7 @@ static ID3D11ShaderResourceView *s_src_srv;
 static IDXGIKeyedMutex          *s_src_mutex;
 static uint32_t                  s_src_tw, s_src_th;
 static volatile int              s_stretch;
+static volatile int              s_upscale;
