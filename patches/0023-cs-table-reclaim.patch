+/* Publish a free or tombstone slot as key. Exclusive-lock only. */
+static CRITICAL_SECTION* xbox_cs_take_slot(XBOX_CS_SLOT* slot, uintptr_t key)
+{
+    if (slot->key == 0)
+        InitializeCriticalSection(&slot->cs);
+    else if (slot->key == XBOX_CS_TOMBSTONE)
+        InitializeCriticalSection(&slot->cs);
+    else
+        return &slot->cs;
+    slot->owner_site = 0;
+    slot->owner_tid = 0;
+    slot->depth = 0;
+    slot->refs = 0;
+    slot->key = key;             /* published last: a shared reader that sees
+                                  * the key sees a live lock behind it */
+    return &slot->cs;
+}
