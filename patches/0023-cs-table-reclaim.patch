 }
 
+static CRITICAL_SECTION* xbox_cs_acquire(PRTL_CRITICAL_SECTION guest)
+{
+    return xbox_cs_shadow_ex(guest, 1, 1);
+}
+
+static CRITICAL_SECTION* xbox_cs_ensure(PRTL_CRITICAL_SECTION guest)
+{
+    return xbox_cs_shadow_ex(guest, 1, 0);
+}
+
+static CRITICAL_SECTION* xbox_cs_find(PRTL_CRITICAL_SECTION guest)
+{
+    return xbox_cs_shadow_ex(guest, 0, 0);
+}
+
+static void xbox_cs_release(CRITICAL_SECTION* cs)
+{
+    XBOX_CS_SLOT* slot = xbox_cs_slot_of(cs);
+    if (slot)
+        InterlockedDecrement(&slot->refs);
+}
