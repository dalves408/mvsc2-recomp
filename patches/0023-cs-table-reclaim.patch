+/* Exclusive-lock only. Deletes host locks for abandoned guest keys that no
+ * thread currently holds a shadow reference on. */
+static int xbox_cs_reclaim_unheld(void)
+{
+    int n = 0;
+    size_t i;
+
+    for (i = 0; i < XBOX_CS_TABLE_SIZE; i++) {
+        XBOX_CS_SLOT* slot = &g_cs_table[i];
+        if (slot->key == 0 || slot->key == XBOX_CS_TOMBSTONE)
+            continue;
+        if (slot->refs != 0 || slot->depth != 0)
+            continue;
+        if (slot->cs.OwningThread != NULL)
+            continue;
+        DeleteCriticalSection(&slot->cs);
+        slot->owner_site = 0;
+        slot->owner_tid = 0;
+        slot->depth = 0;
+        slot->key = XBOX_CS_TOMBSTONE;
+        n++;
+    }
+    if (n) {
+        InterlockedAdd(&g_cs_reclaims, n);
+        g_cs_table_full = 0;
+        xbox_log(XBOX_LOG_INFO, XBOX_LOG_RTL,
+                 "critical-section table reclaimed %d idle shadow(s) "
+                 "(total %ld)", n, (long)g_cs_reclaims);
     }
+    return n;
+}
