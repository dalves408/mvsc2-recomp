 }
 
+/* The host pad's own state, before mapping, deadzones or the keyboard: for
+ * front ends that read controller buttons themselves (menus drawn over the
+ * game). pState is an XINPUT_STATE. */
+DWORD xbox_InputHostState(DWORD dwPort, void *pState)
+{
+    if (dwPort >= XBOX_MAX_CONTROLLERS || !pState)
+        return ERROR_DEVICE_NOT_CONNECTED;
+    return XInputGetState(dwPort, (XINPUT_STATE *)pState);
+}
