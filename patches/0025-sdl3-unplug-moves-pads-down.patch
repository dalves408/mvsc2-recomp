+        if (s_pad[i])
+            continue;
+        for (j = i + 1; j < NPADS && !s_pad[j]; j++)
+            ;
+        if (j == NPADS)
+            break;
+        s_pad[i] = s_pad[j];
+        s_last[i] = s_last[j];
