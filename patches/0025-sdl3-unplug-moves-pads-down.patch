+        s_pad[j] = NULL;
+        memset(&s_last[j], 0, sizeof s_last[j]);
+        SDL_SetGamepadPlayerIndex(s_pad[i], i);
+        fprintf(stderr, "  [PAD] host pad %d moved to Xbox controller port %d (a lower port was unplugged)\n",
+                j, i + 1);
+    }
 
     ids = SDL_GetGamepads(&n);
